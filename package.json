{
  "name": "folio.didoo.net",
  "version": "3.0.0",
  "private": true,
  "description": "Personal portfolio static website",
  "author": "Cristiano Rastelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didoo/folio.didoo.net.git"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "serve": "python3 -m http.server 8000 --directory docs",
    "check": "npm run lint:css && npm run lint:html && npm run check:links && npm run check:classes",
    "lint:css": "stylelint \"docs/assets/css/*.css\"",
    "lint:html": "html-validate \"docs/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:classes": "node scripts/check-classes.mjs"
  },
  "devDependencies": {
    "html-validate": "11.19.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  }
}
